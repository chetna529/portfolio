{
  "name": "portfolio-root",
  "version": "1.0.0",
  "description": "Orchestrates concurrent start commands for Chetna Soni's Full-Stack Portfolio.",
  "scripts": {
    "start": "concurrently \"npm run frontend\" \"npm run backend\"",
    "dev": "npm run dev --prefix frontend",
    "backend": "cd backend && python -m uvicorn app.main:app --port 8000 --reload",
    "frontend": "npm run dev --prefix frontend"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
